# ==============================================================================
# GuardAI - Environment Configuration
# Copy this file to .env.local and fill in your Supabase & Upstash credentials.
# ==============================================================================

# App URL (used for OAuth callbacks, CSRF origin verification, and email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Supabase Configuration
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server-only Service Role Key (REQUIRED for Super Admin global actions,
# force logout, user deletion, and server-side audit/admin operations)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key

# ------------------------------------------------------------------------------
# Upstash Redis Configuration (Rate Limiting, Brute-Force & OTP Protection)
# ------------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=https://your-redis-instance.upstash.io
UPSTASH_REDIS_REST_TOKEN=your-upstash-redis-rest-token
